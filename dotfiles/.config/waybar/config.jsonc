{
    "layer": "top",
    "height": 30,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/rofi",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "tray",
        "wireplumber",
        "backlight",
        "network",
        "hyprland/language",
        "clock",
        "group/power"
    ],
    "custom/rofi": {
        "format": "<span color='#d1524d'></span>",
        "on-click": "pkill rofi || rofi -show drun -location 1",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "default": "",
            "active": "",
            "urgent": ""
        },
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "persistent-workspaces": {
            "*": 7
        }
    },
    "mpris": {
        "format": "<span color='#d1524d'>{status_icon}</span> {title}",
		"status-icons": {
			"playing": "",
			"paused": ""
		},
		"max-length": 60,
        "on-scroll-up": "playerctl -p \"$(playerctl -l | head -n1)\" next",
        "on-scroll-down": "playerctl -p \"$(playerctl -l | head -n1)\" previous",
        "on-click-forward": "playerctl -p \"$(playerctl -l | head -n1)\" next",
        "on-click-backward": "playerctl -p \"$(playerctl -l | head -n1)\" previous",
        "on-click-middle": "pkill rmpc || alacritty -e rmpc",
        "on-click-right": "",
        "tooltip-format": "{dynamic}",
        "dynamic-order": ["artist", "album"]
    },
    "tray": {
        "spacing": 10
    },
    "wireplumber": {
        "format": "<span color='#d1524d'></span> {volume}%",
        "format-muted": "<span color='#d1524d'></span> {volume}%",
        "scroll-step": 2,
        "on-click": "pkill pavucontrol || pavucontrol",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"

    },
    "backlight": {
        "format": "<span color='#d1524d'>󰃠</span> {percent}%",
        "tooltip": false,
        "scroll-step": 2,
        "on-click-forward": "brightnessctl set 10%+",
        "on-click-backward": "brightnessctl set 10%-",
        "on-click": "brightnessctl set 0%",
        "on-click-middle": "brightnessctl set 50%",
        "on-click-right": "brightnessctl set 100%"
    },
    "network": {
        "format-wifi": "<span color='#d1524d'></span> {signalStrength}%",
        "format-disconnected": "<span color='#d1524d'>⚠</span> Disconnected",
        "tooltip-format-wifi": "{essid}"
    },
    "hyprland/language": {
        "format-en": "<span color='#d1524d'>󰌌</span> EN",
        "format-ru": "<span color='#d1524d'>󰌌</span> RU",
        "format-uk": "<span color='#d1524d'>󰌌</span> UA",
        "on-click": "hyprctl switchxkblayout obins-obins-annepro2 next",
        "on-click-right": "hyprctl switchxkblayout obins-obins-annepro2 prev",
        "on-scroll-up": "hyprctl switchxkblayout obins-obins-annepro2 next",
        "on-scroll-down": "hyprctl switchxkblayout obins-obins-annepro2 prev",
        "on-click-forward": "hyprctl switchxkblayout obins-obins-annepro2 next",
        "on-click-backward": "hyprctl switchxkblayout obins-obins-annepro2 prev"
    },
    "clock": {
        "format": "<span color='#d1524d'>󰥔</span> {:%H:%M}",
        "tooltip-format": "<tt><small><span font-family='JetBrainsMono Nerd Font'>{calendar}</span></small></tt>",
        "calendar": {
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#d1524d'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click": "shift_reset",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down",
            "on-click-forward": "shift_up",
            "on-click-backward": "shift_down"
        }
    },
    "group/power": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/power",
            "custom/lock",
            "custom/suspend",
            "custom/reboot"
        ]
    },
    "custom/power": {
        "format": "<span color='#d1524d'></span>",
        "tooltip": false,
        "on-click": "shutdown now"
    },
    "custom/lock": {
        "format": "<span color='#d1524d'>󰍁</span>",
        "tooltip": false,
        "on-click": "hyprlock"
    },
    "custom/suspend": {
        "format": "<span color='#d1524d'></span>",
        "tooltip": false,
        "on-click": "systemctl suspend"
    },
    "custom/reboot": {
        "format": "<span color='#d1524d'></span>",
        "tooltip": false,
        "on-click": "reboot"
    }
}

