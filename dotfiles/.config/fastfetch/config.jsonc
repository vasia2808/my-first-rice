{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "left": 1,
      "right": 2
    },
    "color": {
      "1": "red",
      "2": "red"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "red",
      "title": "red"
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "outputColor": "#b4b4b4"
    },
    {
      "type": "uptime",
      "key": ""
    },
    {
      "type": "cpu",
      "key": "",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰾲",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "",
      "format": "{used} {##a8a8a8}/{#} {total}"
    },
    {
      "type": "disk",
      "key": "",
      "format": "{size-used} {##a8a8a8}/{#} {size-total}"
    }
  ]
}
